<Page
    x:Class="Entanglo.Windows.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- KPIs: one compact row -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}"
                        ToolTipService.ToolTip="Live links">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock x:Name="LinkedCountText" Text="0"
                                   Style="{StaticResource MetricValueStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LinkedSubText" Text="No live links"
                                   Style="{StaticResource CardSubtitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                        ToolTipService.ToolTip="Best round-trip across live links">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock x:Name="LatencyText" Text="—"
                                   Style="{StaticResource MetricValueStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}"
                        ToolTipService.ToolTip="mDNS discovery">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE701;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock x:Name="DiscoveryCountText" Text="0"
                                   Style="{StaticResource MetricValueStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DiscoverySubText" Text="mDNS peers seen"
                                   Style="{StaticResource CardSubtitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active links -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEC27;" FontSize="14"
                                      Foreground="{StaticResource EntangloAccentBrush}"/>
                            <TextBlock Text="Active links" Style="{StaticResource CardTitleStyle}"
                                       ToolTipService.ToolTip="Per-peer transport state and platform"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}"
                                ToolTipService.ToolTip="Listening port">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE968;" FontSize="11"
                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                <TextBlock x:Name="ListenPortText" Text="—"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="LinksEmpty"
                               Text="No active links. Trusted peers will appear here once a TCP session is open."
                               Style="{StaticResource CardSubtitleStyle}"
                               TextWrapping="Wrap"/>

                    <ListView x:Name="LinksList" Background="Transparent" SelectionMode="None"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,2,0,2">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEC27;" FontSize="16"
                                                  Foreground="{StaticResource EntangloAccentBrush}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PlatformVersion}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource PillMutedStyle}"
                                                Margin="0,0,6,0"
                                                ToolTipService.ToolTip="Round-trip latency">
                                            <StackPanel Orientation="Horizontal" Spacing="5"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE945;" FontSize="11"
                                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding RttLabel}"
                                                           Style="{StaticResource PillTextStyle}"
                                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <FontIcon Grid.Column="3" Glyph="&#xE73E;" FontSize="13"
                                                  Foreground="{StaticResource EntangloOkBrush}"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Alive"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
