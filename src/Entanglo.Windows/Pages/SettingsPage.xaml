<Page
    x:Class="Entanglo.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Configure how Entanglo behaves on this Windows machine."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Sharing -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Sharing" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="What this PC accepts from connected Macs"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Receive remote keyboard &amp; mouse"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Text="When OFF, Entanglo ignores input from trusted Macs"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="ReceiveInputToggle"
                                      Toggled="ReceiveInputToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource EntangloBorderSubtleBrush}"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Auto-dial trusted peers"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Text="Reconnect automatically when a known Mac appears on the LAN"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="AutoDialToggle"
                                      Toggled="AutoDialToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- This device -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="This device" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Identity advertised on the LAN"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="DeviceNameText"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="Listen port"
                                   Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevicePortText"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="Screen size"
                                   Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ScreenSizeText"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Text="Device ID"
                                   Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceIdText"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="Copy"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="CopyDeviceId_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Maintenance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Maintenance" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Local state for diagnostics and recovery"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Open data folder"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OpenDataFolder_Click"/>
                        <Button Content="Open log file"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OpenLog_Click"/>
                        <Button Content="Reset device ID"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ResetDeviceId_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="MaintenanceHint"
                               Text="Resetting the device ID will force re-pairing with every trusted Mac on next launch."
                               Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="About" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                        <TextBlock Text="Entanglo • native Mac ↔ Windows bridge"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                        <TextBlock Text="Closing the window keeps Entanglo running in the background. Use this button to fully quit."
                                   Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource DangerButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Quit Entanglo"
                            Click="Quit_Click">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
