<Page
    x:Class="Entanglo.Windows.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Macs and PCs discovered on your network, plus pairing and trust."
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Click="ScanButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pending requests -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Pending requests" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Approve only devices you recognise on this LAN"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillWarnStyle}"
                                ToolTipService.ToolTip="Pending pair requests">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="11"
                                          Foreground="{StaticResource EntangloWarnBrush}"/>
                                <TextBlock x:Name="PendingCountPill" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloWarnBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PendingEmpty"
                               Text="No pending pair requests."
                               Style="{StaticResource CardSubtitleStyle}"/>
                    <ListView x:Name="PendingList" Background="Transparent" SelectionMode="None"
                              MaxHeight="240"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                Background="{StaticResource EntangloWarnSoftBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="18"
                                                      Foreground="{StaticResource EntangloWarnBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DeviceId}" FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Tag="{Binding}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="AllowButton_Click"
                                                    ToolTipService.ToolTip="Allow">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="White"/>
                                            </Button>
                                            <Button Tag="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Click="BlockButton_Click"
                                                    ToolTipService.ToolTip="Block">
                                                <FontIcon Glyph="&#xE711;" FontSize="14"
                                                          Foreground="{StaticResource EntangloDangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Discovered peers card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Discovered on LAN" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Click Connect to open a link"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}"
                                ToolTipService.ToolTip="Discovered devices on LAN">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="11"
                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                <TextBlock x:Name="StatusText" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="DevicesEmpty" Spacing="6" Padding="0,12">
                        <FontIcon Glyph="&#xE968;" FontSize="22"
                                  Foreground="{StaticResource EntangloTextMutedBrush}"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="No devices found yet."
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Make sure the macOS app is open on the same Wi-Fi network."
                                   Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ListView x:Name="DevicesList" SelectionMode="None"
                              Background="Transparent" ItemClick="DevicesList_ItemClick"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                Background="{Binding GlowBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE770;" FontSize="18"
                                                      Foreground="{Binding AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}">
                                                <Run Text="{Binding Host}"/>
                                                <Run Text=":" Foreground="{StaticResource EntangloTextMutedBrush}"/>
                                                <Run Text="{Binding Port}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                                            <Button Visibility="{Binding ConnectVisibility}"
                                                    Tag="{Binding}"
                                                    Click="ConnectButton_Click"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="Connect">
                                                <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="White"/>
                                            </Button>
                                            <Border Visibility="{Binding ConnectedVisibility}"
                                                    Style="{StaticResource PillOkStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="5"
                                                            VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10"
                                                              Foreground="{StaticResource EntangloOkBrush}"/>
                                                    <TextBlock Text="Connected"
                                                               Style="{StaticResource PillTextStyle}"
                                                               Foreground="{StaticResource EntangloOkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Trusted devices -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Trusted devices" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Saved peers that can reconnect automatically"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillOkStyle}"
                                ToolTipService.ToolTip="Trusted devices">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="11"
                                          Foreground="{StaticResource EntangloOkBrush}"/>
                                <TextBlock x:Name="TrustedCountPill" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloOkBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TrustedEmpty"
                               Text="No trusted devices yet. Approve a request above or accept one from the Mac."
                               Style="{StaticResource CardSubtitleStyle}"
                               TextWrapping="Wrap"/>

                    <ListView x:Name="TrustedList" Background="Transparent" SelectionMode="None"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                Background="{StaticResource EntangloOkSoftBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="18"
                                                      Foreground="{StaticResource EntangloOkBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PairedAt}" FontSize="11"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{Binding}"
                                                Click="RevokeButton_Click"
                                                Style="{StaticResource DangerButtonStyle}"
                                                ToolTipService.ToolTip="Remove"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                      Foreground="{StaticResource EntangloDangerBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Manual connect -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Connect manually" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Enter a host and port if mDNS is blocked"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualHost" PlaceholderText="Host (e.g. 192.168.1.63)"/>
                        <TextBox Grid.Column="1" x:Name="ManualPort" PlaceholderText="Port"/>
                        <Button Grid.Column="2"
                                Click="ManualConnect_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Connect">
                            <FontIcon Glyph="&#xE71B;" FontSize="14"
                                      Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
