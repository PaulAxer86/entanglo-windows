<Page
    x:Class="Entanglo.Windows.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock
                        Text="One row per device. Hover over the trust, mouse, keyboard and connection icons for details. Dimmed icons indicate unavailable features."
                        Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Click="ScanButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Refresh"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="White"/>
                </Button>
            </Grid>

            <!-- Pending requests -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Pending requests" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Approve only devices you recognise on this LAN"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillWarnStyle}"
                                ToolTipService.ToolTip="Pending pair requests">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="11"
                                          Foreground="{StaticResource EntangloWarnBrush}"/>
                                <TextBlock x:Name="PendingCountPill" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloWarnBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PendingEmpty" Text="No pending pair requests."
                               Style="{StaticResource CardSubtitleStyle}"/>
                    <ListView x:Name="PendingList" Background="Transparent" SelectionMode="None"
                              MaxHeight="240"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="6"
                                                Background="{StaticResource EntangloWarnSoftBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                                      Foreground="{StaticResource EntangloWarnBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DeviceId}" FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Style="{StaticResource AccentButtonStyle}"
                                                    Click="AllowButton_Click" ToolTipService.ToolTip="Allow">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="White"/>
                                            </Button>
                                            <Button Tag="{Binding}" Style="{StaticResource DangerButtonStyle}"
                                                    Click="BlockButton_Click" ToolTipService.ToolTip="Block">
                                                <FontIcon Glyph="&#xE711;" FontSize="14"
                                                          Foreground="{StaticResource EntangloDangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Unified compact device list -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Devices" Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}"
                                ToolTipService.ToolTip="Known devices">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE968;" FontSize="11"
                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                <TextBlock x:Name="DeviceCountPill" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="DevicesEmpty"
                               Text="No devices found yet. Make sure the other app is open on the same network."
                               Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"
                               Margin="0,4,0,4"/>

                    <ItemsControl x:Name="DevicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="52"/>
                                    </Grid.RowDefinitions>
                                    <!-- Row separator -->
                                    <Border Grid.Row="0" Height="1" Opacity="0.12"
                                            Background="{StaticResource EntangloTextMutedBrush}"/>
                                    <!-- Main row -->
                                    <Grid Grid.Row="1" Padding="2,0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Name + subtitle -->
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- Icon bar -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <!-- Trust -->
                                            <FontIcon Glyph="&#xEB51;" FontSize="13"
                                                      Foreground="{Binding TrustBrush}"
                                                      ToolTipService.ToolTip="Trust status"/>
                                            <!-- RTT -->
                                            <TextBlock Text="{Binding RttDisplay}" FontSize="11"
                                                       MinWidth="38" TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding RttBrush}"/>
                                            <!-- Mouse (input) -->
                                            <FontIcon Glyph="&#xEC18;" FontSize="13"
                                                      Opacity="{Binding FeatureOpacity}"
                                                      Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                                      ToolTipService.ToolTip="Mouse sharing"/>
                                            <!-- Keyboard -->
                                            <FontIcon Glyph="&#xE765;" FontSize="13"
                                                      Opacity="{Binding FeatureOpacity}"
                                                      Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                                      ToolTipService.ToolTip="Keyboard sharing"/>
                                            <!-- Connection -->
                                            <FontIcon Glyph="&#xE701;" FontSize="13"
                                                      Foreground="{Binding ConnectionBrush}"
                                                      ToolTipService.ToolTip="Connection"/>
                                            <!-- Connect (only when not connected) -->
                                            <Button Visibility="{Binding ConnectVisibility}"
                                                    Tag="{Binding}" Click="ConnectButton_Click"
                                                    Width="28" Height="28" Padding="0"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="Connect">
                                                <FontIcon Glyph="&#xE71B;" FontSize="11"
                                                          Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            </Button>
                                            <!-- More actions (trusted devices) -->
                                            <Button Visibility="{Binding RevokeVisibility}"
                                                    Width="28" Height="28" Padding="0"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="More actions">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Revoke trust"
                                                                        Tag="{Binding}"
                                                                        Click="RevokeButton_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;"
                                                                          Foreground="{StaticResource EntangloDangerBrush}"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <FontIcon Glyph="&#xE712;" FontSize="11"
                                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Manual connect -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Connect manually" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Enter a host and port if mDNS is blocked"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualHost" PlaceholderText="Host (e.g. 192.168.1.63)"/>
                        <TextBox Grid.Column="1" x:Name="ManualPort" PlaceholderText="Port"/>
                        <Button Grid.Column="2" Click="ManualConnect_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Connect">
                            <FontIcon Glyph="&#xE71B;" FontSize="14"
                                      Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
