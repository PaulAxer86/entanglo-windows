<Page
    x:Class="Entanglo.Windows.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="News &amp; Updates" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock x:Name="HeaderSubText"
                               Text="What's new in Entanglo for Windows"
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="CheckButton" Click="CheckButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"
                                      Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Text="Check for updates"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Available update banner -->
            <Border x:Name="AvailableCard" Style="{StaticResource CardStyle}"
                    Background="{StaticResource EntangloAccentGlowBrush}"
                    BorderBrush="{StaticResource EntangloAccentBrush}"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="6"
                                Background="{StaticResource EntangloAccentBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="AvailableTitle"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock x:Name="AvailableSubtitle"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="InstallButton" Content="Install…"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="InstallButton_Click"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed"
                                 Foreground="{StaticResource EntangloAccentBrush}"
                                 Background="{StaticResource EntangloSurfaceMutedBrush}"
                                 Height="6" Minimum="0" Maximum="1"/>
                    <ItemsControl x:Name="AvailableHighlights">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•"
                                               Foreground="{StaticResource EntangloAccentBrush}"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Up to date -->
            <Border x:Name="UpToDateCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="6"
                            Background="{StaticResource EntangloOkSoftBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="20"
                                  Foreground="{StaticResource EntangloOkBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="UpToDateTitle"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                        <TextBlock Text="You're running the latest available build."
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What's new in current version -->
            <Border x:Name="WhatsNewCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE82F;" FontSize="14"
                                  Foreground="{StaticResource EntangloWarnBrush}"/>
                        <TextBlock x:Name="WhatsNewTitle"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                        <TextBlock x:Name="WhatsNewDate"
                                   Style="{StaticResource CardSubtitleStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="WhatsNewSubtitle"
                               Foreground="{StaticResource EntangloTextPrimaryBrush}"
                               FontWeight="SemiBold"/>
                    <ItemsControl x:Name="WhatsNewHighlights">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•"
                                               Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Previous releases -->
            <Border x:Name="ChangelogCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Text="Previous releases" Style="{StaticResource CardTitleStyle}"/>
                    <ItemsControl x:Name="ChangelogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Date}"
                                                       Style="{StaticResource CardSubtitleStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="•"
                                                                   Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusFooter"
                       Style="{StaticResource CardSubtitleStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
