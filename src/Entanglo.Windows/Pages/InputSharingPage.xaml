<Page
    x:Class="Entanglo.Windows.Pages.InputSharingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- Sharing toggles: one line each, tooltip carries the explanation -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEC18;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="Share my keyboard &amp; mouse"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"
                                   ToolTipService.ToolTip="When ON, this PC can drive trusted Macs across screen edges"/>
                        <ToggleSwitch Grid.Column="2" x:Name="ShareToggle"
                                      Toggled="ShareToggle_Toggled" Margin="0,-6,-110,-6"
                                      MinWidth="0" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource EntangloBorderSubtleBrush}"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="Receive remote keyboard &amp; mouse"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource EntangloTextPrimaryBrush}"
                                   ToolTipService.ToolTip="When ON, trusted Macs can drive this PC"/>
                        <ToggleSwitch Grid.Column="2" x:Name="ReceiveToggle"
                                      Toggled="ReceiveToggle_Toggled" Margin="0,-6,-110,-6"
                                      MinWidth="0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Edge switching -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A9;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="Edge switching"
                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Pick which trusted device sits on each side of this screen"/>
                        <ToggleSwitch Grid.Column="2" x:Name="EdgeEnabledToggle"
                                      Toggled="EdgeEnabledToggle_Toggled" Margin="0,-6,-110,-6"
                                      MinWidth="0" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="EdgePickers" RowSpacing="8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SoftCardStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE76B;" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{StaticResource EntangloAccentBrush}"
                                          ToolTipService.ToolTip="Left edge"/>
                                <ComboBox Grid.Column="1" x:Name="LeftPeerBox" HorizontalAlignment="Stretch"
                                          PlaceholderText="(no device)"
                                          SelectionChanged="LeftPeerBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{StaticResource EntangloAccentBrush}"
                                          ToolTipService.ToolTip="Right edge"/>
                                <ComboBox Grid.Column="1" x:Name="RightPeerBox" HorizontalAlignment="Stretch"
                                          PlaceholderText="(no device)"
                                          SelectionChanged="RightPeerBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SoftCardStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE70E;" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{StaticResource EntangloAccentBrush}"
                                          ToolTipService.ToolTip="Top edge"/>
                                <ComboBox Grid.Column="1" x:Name="TopPeerBox" HorizontalAlignment="Stretch"
                                          PlaceholderText="(no device)"
                                          SelectionChanged="TopPeerBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SoftCardStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{StaticResource EntangloAccentBrush}"
                                          ToolTipService.ToolTip="Bottom edge"/>
                                <ComboBox Grid.Column="1" x:Name="BottomPeerBox" HorizontalAlignment="Stretch"
                                          PlaceholderText="(no device)"
                                          SelectionChanged="BottomPeerBox_SelectionChanged"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="EdgeHint"
                               Text="Pair a device first under Devices to start mapping edges."
                               Style="{StaticResource CardSubtitleStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Status: single compact row -->
            <Border Style="{StaticResource CardStyle}"
                    ToolTipService.ToolTip="Input injection is blocked unless the receiver is trusted, receive mode is enabled, the heartbeat is alive and emergency stop is not active.">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE703;" FontSize="14" VerticalAlignment="Center"
                              Foreground="{StaticResource EntangloAccentBrush}"
                              ToolTipService.ToolTip="Active target"/>
                    <TextBlock Grid.Column="1" x:Name="PeerText" Text="—" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE823;" FontSize="14" Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource EntangloTextSecondaryBrush}"
                              ToolTipService.ToolTip="Role"/>
                    <TextBlock Grid.Column="3" x:Name="RoleText" Text="Idle" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                    <Button Grid.Column="5" Style="{StaticResource DangerButtonStyle}"
                            Click="StopButton_Click"
                            ToolTipService.ToolTip="Emergency stop (same as pressing Escape × 3)">
                        <FontIcon Glyph="&#xE71A;" FontSize="14"
                                  Foreground="{StaticResource EntangloDangerBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
