<Page
    x:Class="Entanglo.Windows.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:net="using:Entanglo.Core.Net"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Live status of your trusted link between Mac and Windows."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Hero link card -->
            <Border x:Name="HeroCard" Style="{StaticResource HeroCardStyle}"
                    BorderThickness="1" BorderBrush="#33FFFFFF">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="6"
                            Background="#33FFFFFF" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE968;" FontSize="26" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="LinkTitleText" Text="Waiting"
                                   FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="LinkSubtitleText"
                                   Text="Looking for trusted peers on the local network"
                                   FontSize="13" Foreground="#E6FFFFFF" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="44" Height="44" CornerRadius="6"
                            Background="#33FFFFFF" VerticalAlignment="Center">
                        <FontIcon x:Name="LinkPillIcon" Glyph="&#xE823;" FontSize="20"
                                  Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI tiles -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LINKED" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock x:Name="ConnectedCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="active sessions" Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TRUSTED" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock x:Name="TrustedCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="paired devices" Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LATENCY" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="best peer RTT" Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active peers -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Active peers" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Devices currently linked over Entanglo"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}"
                                ToolTipService.ToolTip="Active peers online">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" FontSize="11"
                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                <TextBlock x:Name="ActivePeersCountText" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="PeersEmptyState" Spacing="6" Padding="0,12">
                        <FontIcon Glyph="&#xE701;" FontSize="22"
                                  Foreground="{StaticResource EntangloTextMutedBrush}"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="No peer is connected yet."
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Open Devices to discover Macs on the same Wi-Fi and dial them."
                                   Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ListView x:Name="PeersList" SelectionMode="None"
                              Background="Transparent"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="net:ActivePeer">
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                Background="{StaticResource EntangloAccentGlowBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="18"
                                                      Foreground="{StaticResource EntangloAccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind Platform}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource PillAccentStyle}"
                                                Margin="0,0,8,0"
                                                ToolTipService.ToolTip="Round-trip latency (ms)">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE945;" FontSize="11"
                                                          Foreground="{StaticResource EntangloAccentBrush}"/>
                                                <TextBlock Style="{StaticResource PillTextStyle}"
                                                           Foreground="{StaticResource EntangloAccentBrush}"
                                                           Text="{x:Bind RttDisplay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Width="32" Height="32" CornerRadius="6"
                                                Background="{StaticResource EntangloOkSoftBrush}"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Linked">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                      Foreground="{StaticResource EntangloOkBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Bottom row -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="This device" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Identity advertised to peers"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <Grid RowSpacing="10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="DeviceNameText" Text="This PC"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevicePortText" Text="—"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="Roles" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DeviceRoleText" Text="Controller · Receiver"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Text="Device ID" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceIdText" Text="—"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Quick actions" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Send something to a connected peer"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="White"/>
                                    <TextBlock Text="Push URL"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE722;" FontSize="14"
                                              Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                    <TextBlock Text="Capture screen"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Tip: use Ctrl+Alt+E to toggle input sharing on the active link."
                                   Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hidden legacy elements kept for code-behind compatibility -->
            <TextBlock x:Name="InputStatusText" Text="Idle" Visibility="Collapsed"/>
            <TextBlock x:Name="PairingSummaryText" Text="No connected peers yet" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
