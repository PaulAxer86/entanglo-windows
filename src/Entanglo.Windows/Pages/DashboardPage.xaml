<Page
    x:Class="Entanglo.Windows.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:net="using:Entanglo.Core.Net"
    Background="Transparent">

    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- Link banner: status + KPI pills in one compact row -->
            <Border x:Name="HeroCard" Style="{StaticResource HeroCardStyle}"
                    BorderThickness="1" BorderBrush="#33FFFFFF">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE968;" FontSize="24" Foreground="White"
                              VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LinkTitleText" Text="Waiting"
                                   FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="LinkSubtitleText"
                                   Text="Looking for trusted peers on the local network"
                                   FontSize="11" Foreground="#CCFFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- KPI pills: icon + value, tooltip replaces the label -->
                    <Border Grid.Column="2" Background="#2EFFFFFF" CornerRadius="6"
                            Padding="8,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Active sessions">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="White"/>
                            <TextBlock x:Name="ConnectedCountText" Text="0"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#2EFFFFFF" CornerRadius="6"
                            Padding="8,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Trusted (paired) devices">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE716;" FontSize="12" Foreground="White"/>
                            <TextBlock x:Name="TrustedCountText" Text="0"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#2EFFFFFF" CornerRadius="6"
                            Padding="8,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Best peer round-trip latency">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="White"/>
                            <TextBlock x:Name="LatencyText" Text="—"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="5" Width="32" Height="32" CornerRadius="6"
                            Background="#2EFFFFFF" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Link status">
                        <FontIcon x:Name="LinkPillIcon" Glyph="&#xE823;" FontSize="15"
                                  Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Two-column grid, macOS style -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- This device -->
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F8;" FontSize="14"
                                      Foreground="{StaticResource EntangloAccentBrush}"
                                      ToolTipService.ToolTip="This device"/>
                            <TextBlock Text="This device" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <Grid RowSpacing="6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="DeviceNameText" Text="This PC" FontSize="12"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevicePortText" Text="—" FontSize="12"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Text="Roles" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DeviceRoleText" Text="Controller · Receiver" FontSize="12"
                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Text="ID" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceIdText" Text="—"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick actions: icon-only buttons with tooltips -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14"
                                      Foreground="{StaticResource EntangloAccentBrush}"
                                      ToolTipService.ToolTip="Quick actions"/>
                            <TextBlock Text="Quick actions" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Push URL to a connected peer">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Capture screen">
                                <FontIcon Glyph="&#xE722;" FontSize="14"
                                          Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                      Foreground="{StaticResource EntangloTextMutedBrush}"/>
                            <TextBlock Text="Ctrl+Alt+E toggles input sharing"
                                       Style="{StaticResource CardSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active peers -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE716;" FontSize="14"
                                      Foreground="{StaticResource EntangloAccentBrush}"
                                      ToolTipService.ToolTip="Active peers"/>
                            <TextBlock Text="Active peers" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}"
                                ToolTipService.ToolTip="Active peers online">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" FontSize="11"
                                          Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                <TextBlock x:Name="ActivePeersCountText" Text="0"
                                           Style="{StaticResource PillTextStyle}"
                                           Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="PeersEmptyState" Orientation="Horizontal" Spacing="8" Padding="0,4">
                        <FontIcon Glyph="&#xE701;" FontSize="16"
                                  Foreground="{StaticResource EntangloTextMutedBrush}"/>
                        <TextBlock Text="No peer connected — pair one in Devices."
                                   Style="{StaticResource CardSubtitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListView x:Name="PeersList" SelectionMode="None"
                              Background="Transparent"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="net:ActivePeer">
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,2,0,2">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16"
                                                  Foreground="{StaticResource EntangloAccentBrush}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DeviceName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind Platform}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource PillAccentStyle}"
                                                Margin="0,0,6,0"
                                                ToolTipService.ToolTip="Round-trip latency (ms)">
                                            <StackPanel Orientation="Horizontal" Spacing="5"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE945;" FontSize="11"
                                                          Foreground="{StaticResource EntangloAccentBrush}"/>
                                                <TextBlock Style="{StaticResource PillTextStyle}"
                                                           Foreground="{StaticResource EntangloAccentBrush}"
                                                           Text="{x:Bind RttDisplay}"/>
                                            </StackPanel>
                                        </Border>
                                        <FontIcon Grid.Column="3" Glyph="&#xE73E;" FontSize="13"
                                                  Foreground="{StaticResource EntangloOkBrush}"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Linked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Hidden legacy elements kept for code-behind compatibility -->
            <TextBlock x:Name="InputStatusText" Text="Idle" Visibility="Collapsed"/>
            <TextBlock x:Name="PairingSummaryText" Text="No connected peers yet" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
