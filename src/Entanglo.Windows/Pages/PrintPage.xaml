<Page
    x:Class="Entanglo.Windows.Pages.PrintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <StackPanel Padding="12" Spacing="8" Orientation="Horizontal">
        <FontIcon Glyph="&#xE749;" FontSize="14" VerticalAlignment="Center"
                  Foreground="{StaticResource EntangloAccentBrush}"/>
        <TextBlock Text="Printer Bridge (Phase 3)" FontSize="13" VerticalAlignment="Center"
                   Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
    </StackPanel>
</Page>
