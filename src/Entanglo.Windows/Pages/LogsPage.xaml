<Page
    x:Class="Entanglo.Windows.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="28,20,28,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Logs" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Live activity log for the Entanglo runtime on this PC."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="6,4,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Activity log" Style="{StaticResource CardTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource PillMutedStyle}">
                        <TextBlock x:Name="CountText" Text="0 entries"
                                   Style="{StaticResource PillTextStyle}"
                                   Foreground="{StaticResource EntangloTextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <ListView Grid.Row="1" x:Name="LogList" Background="Transparent" SelectionMode="None"
                          ItemContainerStyle="{x:Null}"
                          ItemContainerTransitions="{x:Null}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource EntangloTextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding LevelGlowBrush}"
                                            CornerRadius="6" Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Level}"
                                                   Style="{StaticResource PillTextStyle}"
                                                   Foreground="{Binding LevelBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
