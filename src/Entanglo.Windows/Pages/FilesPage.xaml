<Page
    x:Class="Entanglo.Windows.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="Files" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Send files to your paired devices. Received files land in %LocalAppData%\Entanglo\Downloads\."
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Send card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE898;" FontSize="16"
                                  Foreground="{StaticResource EntangloAccentBrush}"/>
                        <TextBlock Text="Send a file" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PeerCombo"
                                  PlaceholderText="Choose a connected device…"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" x:Name="PickButton"
                                Click="PickButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" Foreground="White"/>
                                <TextBlock Text="Choose file…"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="SendStatus"
                               Style="{StaticResource CardSubtitleStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Transfers card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B5;" FontSize="16"
                                      Foreground="{StaticResource EntangloAccentBrush}"/>
                            <TextBlock Text="Transfers" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenDownloadsButton"
                                    Click="OpenDownloadsButton_Click"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="12"
                                              Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                    <TextBlock Text="Open Downloads"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearButton"
                                    Click="ClearButton_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"
                                              Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                    <TextBlock Text="Clear finished"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EmptyLabel"
                               Text="No transfers yet."
                               Style="{StaticResource CardSubtitleStyle}"
                               Visibility="Visible"/>

                    <ItemsControl x:Name="TransferList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,4,0,4">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="14"
                                                      Foreground="{Binding TintBrush}"
                                                      VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource EntangloTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding SubtitleText}"
                                                           Style="{StaticResource CardSubtitleStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                       Style="{StaticResource CardSubtitleStyle}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}"
                                                     Maximum="1" Minimum="0" Height="4"
                                                     Foreground="{Binding TintBrush}"
                                                     Background="{StaticResource EntangloSurfaceMutedBrush}"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
