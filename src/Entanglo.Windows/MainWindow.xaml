<Window
    x:Class="Entanglo.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Entanglo.Windows"
    Title="Entanglo">

    <Grid>
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Tools"/>
                <NavigationViewItem Tag="Dashboard"    Icon="Home"     Content="Dashboard"     />
                <NavigationViewItem Tag="Devices"      Icon="People"   Content="Devices"       />
                <NavigationViewItem Tag="InputSharing" Icon="Switch"   Content="Input Sharing" />
                <NavigationViewItem Tag="Files"        Icon="Document" Content="Files"         />
                <NavigationViewItem Tag="Print"        Icon="Print"    Content="Print"         />
                <NavigationViewItemSeparator/>
                <NavigationViewItemHeader Content="Utilities"/>
                <NavigationViewItem Tag="Network"      Icon="Map"      Content="Network"        />
                <NavigationViewItem Tag="Updates"      Icon="Globe"    Content="News &amp; Updates"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Icon="Setting" Content="Settings" />
                <NavigationViewItem Tag="Logs"     Icon="List"    Content="Logs"     />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
